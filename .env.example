# ---------------------------------------------------------------------------
# APP_URL — the public origin this site is served from.
#
# Used as `metadataBase` so Open Graph and Twitter card images resolve to
# absolute URLs. Without it, link previews point at localhost and social
# crawlers fetch nothing.
#
# Set this in Vercel → Project → Settings → Environment Variables for the
# Production environment, e.g. https://hughesnet.vercel.app or your own domain.
# ---------------------------------------------------------------------------
APP_URL="https://your-domain.com"
