# ---------------------------------------------------------------------------
# APP_URL — the public origin this site is served from. OPTIONAL.
#
# Backs `metadataBase`, which makes Open Graph and Twitter card image paths
# absolute. If unset, the app falls back to Vercel's injected VERCEL_URL, then
# to localhost — so previews work on Vercel with no configuration at all.
#
# Set it once you have a custom domain. Leave it UNSET rather than blank if you
# do not have one; a blank value is ignored safely, but there is no reason to
# define it empty.
# ---------------------------------------------------------------------------
APP_URL="https://your-domain.com"
